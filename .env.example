# Manager.io instance (opaque base URL; include /api2 when required)
MANAGER_API_URL=http://127.0.0.1:55667/api2
MANAGER_API_KEY=your-access-token-here

# Integration tests (pytest -m integration) use a separate sandbox business:
TEST_MANAGER_API_URL=http://127.0.0.1:55667/api2
TEST_MANAGER_API_KEY=your-test-access-token-here

# Scoped writes (comma-separated; no wildcards). Empty = read-only.
# Valid: quotes,orders,parties,items,sales,purchases,banking,payroll,ledger
# MCP host env (e.g. .cursor/mcp.json) MUST match these or behavior drifts.
#
# Quotes only:
# MANAGER_MCP_WRITE_SCOPES=quotes
# MANAGER_MCP_DELETE_SCOPES=quotes
#
# All implemented scopes (same CSV as a full-write Cursor MCP config):
# MANAGER_MCP_WRITE_SCOPES=quotes,orders,parties,items,sales,purchases,banking,payroll,ledger
# MANAGER_MCP_DELETE_SCOPES=quotes,orders,parties,items,sales,purchases,banking,payroll,ledger
#
# Legacy MANAGER_MCP_ALLOW_WRITES / ALLOW_WRITES / MANAGER_MCP_WRITES hard-fail if set.

# Transport: "stdio" (default, local MCP host) or "http" (remote, e.g. Claude
# Cowork). http requires Google OAuth config below and is meant to sit behind
# a reverse proxy terminating TLS.
# MANAGER_MCP_TRANSPORT=http
# MANAGER_MCP_HTTP_HOST=0.0.0.0
# MANAGER_MCP_HTTP_PORT=8080

# Google OAuth client for the http transport (separate client from any other
# service's OAuth app; redirect URI is {MANAGER_MCP_OAUTH_BASE_URL}/auth/callback).
# MANAGER_MCP_OAUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# MANAGER_MCP_OAUTH_GOOGLE_CLIENT_SECRET=your-client-secret
# MANAGER_MCP_OAUTH_BASE_URL=https://manager-mcp.example.com

# Comma-separated emails permitted to authenticate. GoogleProvider alone
# accepts ANY Google account that logs in successfully; this allowlist is
# enforced on top of it and is required whenever transport=http.
# MANAGER_MCP_ALLOWED_EMAILS=you@example.com

# Seconds between Manager bank-feed pulls ("Check for New Transactions").
# Unset or 0 disables (the stdio/dev default). Compose sets 3600.
# MANAGER_MCP_BANK_FEED_SYNC_INTERVAL_SECONDS=3600
